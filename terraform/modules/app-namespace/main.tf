# Application namespace + generated secrets.
# Secrets are generated by Terraform (random_password) and stored only in
# Terraform state and the cluster — never in Git. Protect the state file.

locals {
  labels = {
    "app.kubernetes.io/part-of"          = "devsecops360"
    "devsecops360/environment"           = var.environment
    "pod-security.kubernetes.io/enforce" = "restricted"
    "pod-security.kubernetes.io/audit"   = "restricted"
    "pod-security.kubernetes.io/warn"    = "restricted"
  }
}

resource "kubernetes_namespace_v1" "app" {
  metadata {
    name   = var.namespace
    labels = local.labels
  }

  lifecycle {
    # kubectl apply -k also manages this namespace; don't fight over metadata.
    ignore_changes = [metadata[0].annotations, metadata[0].labels]
  }
}

resource "random_password" "postgres" {
  length  = 32
  special = false # used inside a connection URL — avoid characters needing escaping
}

resource "random_password" "jwt" {
  length  = 64
  special = false
}

resource "random_password" "admin" {
  length           = 20
  special          = true
  override_special = "-_!"
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
}

resource "random_password" "demo" {
  count            = var.seed_demo_users ? 1 : 0
  length           = 16
  special          = true
  override_special = "-_"
  min_upper        = 1
  min_lower        = 1
  min_numeric      = 1
}

resource "kubernetes_secret_v1" "backend" {
  metadata {
    name      = "backend-secrets"
    namespace = kubernetes_namespace_v1.app.metadata[0].name
    labels    = { "app.kubernetes.io/part-of" = "devsecops360" }
  }

  type = "Opaque"
  data = merge(
    {
      POSTGRES_PASSWORD = random_password.postgres.result
      JWT_SECRET_KEY    = random_password.jwt.result
      ADMIN_PASSWORD    = random_password.admin.result
    },
    var.seed_demo_users ? { DEMO_USER_PASSWORD = random_password.demo[0].result } : {}
  )
}
