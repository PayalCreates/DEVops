# Secrets for Ansible-driven Compose deployments.
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml          # vault.yml is git-ignored even when encrypted
#   ansible-playbook playbooks/deploy-compose.yml --ask-vault-pass -e @inventories/local/group_vars/vault.yml
vault_postgres_password: "change-me"
vault_jwt_secret_key: "change-me-at-least-32-characters-long-000"
vault_admin_password: "change-me-Admin1"
vault_demo_user_password: "change-me-Demo1"
vault_grafana_admin_password: "change-me-grafana"
