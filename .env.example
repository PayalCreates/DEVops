# ---------------------------------------------------------------------------
# DevSecOps360 — Docker Compose environment.
# Copy to `.env` (git-ignored) and replace EVERY "change-me" value.
#   PowerShell:  Copy-Item .env.example .env
#   Linux/WSL:   cp .env.example .env
# Generate secrets:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# Image tags (local builds use "local"; CI pushes ghcr.io/<owner>/devsecops360-*:<sha>)
IMAGE_REGISTRY=ghcr.io/your-github-username
IMAGE_TAG=local

# PostgreSQL
POSTGRES_DB=devsecops360
POSTGRES_USER=devsecops
POSTGRES_PASSWORD=change-me-db-password

# Backend
ENVIRONMENT=development
JWT_SECRET_KEY=change-me-use-at-least-32-random-characters-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080
ADMIN_EMAIL=admin@devsecops360.dev
ADMIN_PASSWORD=change-me-Admin1
SEED_SAMPLE_DATA=true
DEMO_USER_PASSWORD=change-me-Demo1

# Observability (only used with --profile monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Ports published on your laptop
FRONTEND_PORT=8080
